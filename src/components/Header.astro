---
import Navigation from "./Navigation.astro";
---

<header class="main-navigation">
    <h2>
        <a href="/" class="logo">
            <img src="/assets/logo-harmaa.png" width="80px" height="80px" alt="" />
            <span class="sr-only">Kasvata & kohtaa</span>
        </a>
    </h2>
    <Navigation placement="header" orientation="horizontal" />
</header>

<style>


    a {
        text-decoration: none;
        color: currentColor;
    }

    .logo {
        font-family: var(--ff-display);
        font-weight: var(--fw-light);
        font-size: var(--fs-2);
        line-height: 1.1;
    }
</style>