---
import Navigation from "./Navigation.astro";
---

<footer class="content-grid">
    <img class="footer-image full-width" src="/images/footer.webp" alt="" />
    <section class="footer-content">
        <Navigation />
        <div class="column">
            <h2>Kasvata & kohtaa</h2>
            <p>Y-tunnus: 3494394-7 (Tiimitaito Oy)</p>
            <div class="cta-footer">
                <div class="button-group">
                    <a href="mailto:info@kasvatajakohtaa.fi">
                        <img src="/assets/email.svg" alt="" width="24px" />
                        <span class="sr-only">Kysy lisää sähköpostilla </span>
                        <span>info@kasvatajakohtaa.fi</span>
                    </a>
                    <a href="https://www.instagram.com/kasvatajakohtaa">
                        <img src="/assets/instagram.svg" alt="" width="24px" />
                        <span class="sr-only">Seuraa meitä Instagramissa </span>
                        <span>@kasvatajakohtaa</span>
                    </a>
                </div>
            </div>
        </div>
    </section>
    <section class="copyright full-width">
        Copyright &copy; 2026 Kasvata ja kohtaa
    </section>
</footer>

<style>
    footer {
        background-color: var(--clr-red-wine);
        color: var(--clr-pink-light);
    }

    .footer-image {
        aspect-ratio: 3/1;
        object-fit: cover;
        object-position: bottom;
    }

    .column > p {
        margin-block-end: 0;
    }

    .copyright {
        display: flex;
        justify-content: center;
        align-items: center;
        padding-block: var(--space-m);
        background: var(--clr-red-wine-dark);
        width: 100vw;
    }
</style>