---
import Navigation from "./Navigation.astro";
---

<footer class="content-grid">
    <img class="full-width" src="/images/footer.webp" alt="" />
    <section class="footer-content">
        <Navigation />
        <article>
            <h2>Kasvata & kohtaa</h2>
            <p>Y-tunnus: 3494394-7 (Tiimitaito Oy)</p>
            <p>email: <a href="mailto:info@kasvatajakohtaa.fi">info@kasvatajakohtaa.fi</a></p>
        </article>
    </section>
    <section class="copyright full-width">
        Copyright &copy; 2026 Kasvata ja kohtaa
    </section>
</footer>

<style>
    footer {
        background-color: var(--clr-red-wine);
        color: var(--clr-pink-light);
    }

    img {
        aspect-ratio: 3/1;
        object-fit: cover;
        object-position: bottom;
    }

    .footer-content {

        display: grid;
        grid-template-columns: 1fr 1fr;

        padding-block: var(--space-m);

        h2 {
            font-size: var(--fs-2);
            margin: 0;
            margin-block-end: var(--space-m);
        }

        a {
            color: inherit;
        }

        article p:last-child {
            margin-block-end: 0;
        }
    }

    .copyright {
        display: flex;
        justify-content: center;
        align-items: center;
        padding-block: var(--space-m);
        background: var(--clr-red-wine-dark);
        width: 100vw;
    }
</style>